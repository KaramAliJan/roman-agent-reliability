.history/


# =========================================================
# Private / local-only working files
# =========================================================

local/
scratch/
debug/
notes_private/


# =========================================================
# Large archives -- packaged deliverables, not source
# =========================================================

*.zip
*.tar
*.tar.gz
*.7z
*.rar


# =========================================================
# Raw run artifacts (optional -- see note)
# =========================================================

# Your actual results folder is results/ -- NOT ignored by default,
# since your comparison tables and run logs are real research outputs
# you likely want version-controlled for reproducibility. Uncomment only
# if repeated dev-run logs start bloating the repo:
# results/*.json

traces/
raw_outputs/